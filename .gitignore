bin/
dist/
coverage.out
hack/.e2e-kubeconfig
*.db
*.test
core.*

# Self-signed serving certificates the apiserver generates when none are
# supplied. The default --cert-dir is relative to the working directory, so a
# stray run leaves a private key in the tree.
apiserver.local.config/
.alerts-check.yaml
.alerts-rendered.yaml

# The Pagila sample database, fetched by hack/fetch-pagila.sh rather than
# vendored: it is somebody else's data, and upstream keeps the copy of record.
third_party/pagila/*.sql
