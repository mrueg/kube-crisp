# The credential the e2e kube-apiserver presents to the projection webhook.
#
# A static token, which the kube-apiserver itself is started with from
# tokens.csv next to this file: kube-crisp verifies it through a TokenReview,
# the same path a ServiceAccount token takes, and the identity it resolves to
# is bound to kube-crisp:projection-webhook-caller by
# test/e2e/manifests/webhook-caller.yaml. Not a secret — this cluster is a
# throwaway — and not usable anywhere else.
apiVersion: v1
kind: Config
users:
  - name: kube-crisp-apiserver.kube-crisp.svc
    user:
      token: e2e-projection-webhook-caller-token
