// A module of its own, so that the AWS SDK is not in kube-crisp's go.mod.
//
// Fifteen modules and about 4 MB of linked binary, none of which a build
// projecting a SQLite file can reach. A build tag would not have helped: a file
// excluded by a tag still contributes its imports to the module graph, so
// go.mod and go.sum would carry the SDK either way and every consumer of
// kube-crisp as a library would resolve it. A separate module is the only shape
// in which the cost is paid by the builds that want it and by nobody else.
//
// The replace is for developing the two together out of one checkout. It is
// ignored when this module is required by another, so it costs a consumer
// nothing — they resolve kube-crisp at the version below.
module github.com/mrueg/kube-crisp/providers/aws

go 1.26.7

replace github.com/mrueg/kube-crisp => ../..

require (
	github.com/aws/aws-sdk-go-v2 v1.45.1
	github.com/aws/aws-sdk-go-v2/config v1.33.2
	github.com/aws/aws-sdk-go-v2/credentials v1.20.2
	github.com/aws/aws-sdk-go-v2/feature/rds/auth v1.7.1
	github.com/go-sql-driver/mysql v1.10.0
	github.com/jackc/pgx/v5 v5.10.0
	github.com/mrueg/kube-crisp v0.0.0-00010101000000-000000000000
	k8s.io/apiserver v0.37.0
	k8s.io/component-base v0.37.0
)

